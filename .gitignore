node_modules/

# build output
dist/

# your photo library — lives in Cloudflare R2, never in Git.
# Originals sync to the private photos-originals bucket via `npm run sync`.
photos/

# auto-generated web images (rebuilt from /photos by `npm run generate`,
# uploaded to the public photos-web bucket by `npm run sync`)
public/generated/

