{
  "name": "photo-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A self-hosted gallery for 35mm photography",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "sync:web": "rclone sync public/generated r2:photos-web/generated --checksum --max-delete 25 --progress",
    "sync:originals": "rclone copy photos r2:photos-originals --checksum --progress",
    "sync": "npm run generate && npm run sync:web && npm run sync:originals"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.251",
    "claude": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.4",
    "vite": "^6.0.0"
  }
}
